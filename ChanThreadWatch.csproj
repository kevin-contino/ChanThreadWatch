<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>JDP</RootNamespace>
    <AssemblyName>ChanThreadWatch</AssemblyName>
    <ApplicationIcon>ChanThreadWatch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
    <!-- Properties\AssemblyInfo.cs is the only version source; release.yml and prepare-release.ps1 read it -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
    <!-- The release and the tests expect bin\<Configuration>\ChanThreadWatch.exe, without a target framework folder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Same as the old-style project: an AnyCPU exe that prefers 32-bit, and a non-deterministic build.
         An explicit PlatformTarget also stops the SDK from inferring a win-x86 RuntimeIdentifier for a .NET Framework exe. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <Deterministic>false</Deterministic>
    <WarningLevel>4</WarningLevel>
    <DebugSymbols>true</DebugSymbols>
    <!-- App.config already declares supportedRuntime; this keeps ChanThreadWatch.exe.config a byte copy of it -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <!-- The old-style project never generated redirects; keep exe.config a copy even if a package conflict appears later -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Pinned so the locked restore in CI does not depend on the build tools' default -->
    <RuntimeIdentifiers>win;win-arm64;win-x64;win-x86</RuntimeIdentifiers>
    <!-- The explicit .net48 reference package is used everywhere, so the lock file does not depend on whether the machine has the targeting pack -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <!-- The project sits at the repository root, so the default globs would include the other projects, tools and temp -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <!-- The old-style project set latest for Debug only; Release uses the net48 default (7.3) -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides .NET 4.8 reference assemblies so the build does not need the Developer Pack installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ChanThreadWatch.Core\ChanThreadWatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Classes\GUI.cs" />
    <Compile Include="frmChanThreadWatch.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmChanThreadWatch.Designer.cs">
      <DependentUpon>frmChanThreadWatch.cs</DependentUpon>
    </Compile>
    <Compile Include="frmDownloads.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmDownloads.Designer.cs">
      <DependentUpon>frmDownloads.cs</DependentUpon>
    </Compile>
    <Compile Include="frmSettings.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmSettings.Designer.cs">
      <DependentUpon>frmSettings.cs</DependentUpon>
    </Compile>
    <Compile Include="frmThreadEdit.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmThreadEdit.Designer.cs">
      <DependentUpon>frmThreadEdit.cs</DependentUpon>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <EmbeddedResource Include="frmChanThreadWatch.resx">
      <SubType>Designer</SubType>
      <DependentUpon>frmChanThreadWatch.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="frmDownloads.resx">
      <DependentUpon>frmDownloads.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="frmSettings.resx">
      <DependentUpon>frmSettings.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="frmThreadEdit.resx">
      <DependentUpon>frmThreadEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <None Include="App.config" />
    <None Include="app.manifest">
      <SubType>Designer</SubType>
    </None>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <Content Include="ChanThreadWatch.ico" />
  </ItemGroup>

</Project>
