<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ctw</AssemblyName>
    <RootNamespace>JDP.Cli</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The release architectures (see .github/scripts/publish-cli.ps1). Pinned so the lock file lists their runtime
         packs, and the locked restore in CI does not depend on the SDK's default -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- The release is a single file per OS, so code that needs a file path for an assembly is reported -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- The version below is the whole version; no commit hash appended to it -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- One shared version for every app (G13): the WinForms app's Properties\AssemblyInfo.cs is the only version source.
       Its AssemblyVersion ("1.N.0.R") is read here at build time; the build fails if it is not found. -->
  <PropertyGroup>
    <WinFormsAssemblyInfoPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'ChanThreadWatch', 'Properties', 'AssemblyInfo.cs'))</WinFormsAssemblyInfoPath>
    <WinFormsAssemblyVersionPattern>(?m)^\[assembly: AssemblyVersion\("(\d+\.\d+\.\d+\.\d+)"\)\]</WinFormsAssemblyVersionPattern>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(WinFormsAssemblyInfoPath)')">
    <WinFormsAssemblyInfoText>$([System.IO.File]::ReadAllText('$(WinFormsAssemblyInfoPath)'))</WinFormsAssemblyInfoText>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WinFormsAssemblyInfoText)' != '' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(WinFormsAssemblyInfoText)', '$(WinFormsAssemblyVersionPattern)'))">
    <WinFormsVersion>$([System.Text.RegularExpressions.Regex]::Match('$(WinFormsAssemblyInfoText)', '$(WinFormsAssemblyVersionPattern)').Groups.get_Item(1).Value)</WinFormsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WinFormsVersion)' != ''">
    <Version>$(WinFormsVersion)</Version>
    <AssemblyVersion>$(WinFormsVersion)</AssemblyVersion>
    <FileVersion>$(WinFormsVersion)</FileVersion>
    <InformationalVersion>$(WinFormsVersion)</InformationalVersion>
  </PropertyGroup>

  <Target Name="RequireWinFormsVersion" BeforeTargets="PrepareForBuild;GetAssemblyVersion">
    <Error Condition="'$(WinFormsVersion)' == ''" Text="AssemblyVersion(&quot;1.N.0.R&quot;) not found in $(WinFormsAssemblyInfoPath); ctw takes its version from there." />
  </Target>

  <!-- Release assets: dotnet publish ChanThreadWatch.Cli.csproj -c Release -r <rid> gives one self-contained file that
       needs no .NET install, as the app's exe (see ChanThreadWatch.csproj). A build without a runtime identifier (the
       tests) stays framework-dependent. -->
  <PropertyGroup Condition=" '$(RuntimeIdentifier)' != '' ">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- The Windows runtime packs of ASP.NET Core carry its IIS in-process module, a native file that the single file
       would extract to disk (once for each version of the file). ctw never runs in IIS (the local API is Kestrel only),
       so it is left out of the runtime pack's assets, which both ctw.deps.json and the publish are made from.
       ResolveRuntimePackAssets also adds them to ReferenceCopyLocalPaths, so it goes from there too. -->
  <Target Name="RemoveIisModule" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <_CtwIisModule Include="@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
      <RuntimePackAsset Remove="@(_CtwIisModule)" />
      <ReferenceCopyLocalPaths Remove="@(_CtwIisModule)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The same globalization mode as the app (see ChanThreadWatch.csproj); ignored off Windows -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChanThreadWatch.Core\ChanThreadWatch.Core.csproj" />
    <!-- The local API that ctw watch hosts (MP-7a). It brings the ASP.NET Core shared framework, which the
         self-contained single file then carries (no trimming) -->
    <ProjectReference Include="..\ChanThreadWatch.Api\ChanThreadWatch.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChanThreadWatch.Cli.Tests" />
  </ItemGroup>

</Project>
