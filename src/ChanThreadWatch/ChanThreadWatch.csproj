<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Program.Main calls ApplicationConfiguration.Initialize, which applies these.
         PerMonitor matches the dpiAware True/PM the manifest declared on .NET Framework, and the
         default font is the .NET Framework one (.NET 10 would use Segoe UI 9), so every form
         and dialog keeps its size and layout. -->
    <ApplicationHighDpiMode>PerMonitor</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <!-- The release is a single-file exe, so code that needs a file path for an assembly is reported -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RootNamespace>JDP</RootNamespace>
    <AssemblyName>ChanThreadWatch</AssemblyName>
    <ApplicationIcon>ChanThreadWatch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
    <!-- Properties\AssemblyInfo.cs is the only version source; release.yml and prepare-release.ps1 read it -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
    <!-- The release and the tests expect bin\<Configuration>\ChanThreadWatch.exe, without a target framework folder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Same as the old-style project: a non-deterministic build -->
    <Deterministic>false</Deterministic>
    <WarningLevel>4</WarningLevel>
    <DebugSymbols>true</DebugSymbols>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The release architectures (G14). Pinned so the lock file lists their runtime packs, and the locked
         restore in CI does not depend on the SDK's default -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The items are listed below. This dates from when the project sat at the repository root, where the default
         globs would include the other projects, tools and temp -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <!-- Release assets: dotnet publish ChanThreadWatch.csproj -c Release -r win-x64 (or win-arm64) gives one
       self-contained exe that needs no .NET install. A build without a runtime identifier (tests, UI tests)
       stays framework-dependent. -->
  <PropertyGroup Condition=" '$(RuntimeIdentifier)' != '' ">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <!-- The old-style project set latest for Debug only; Release uses the SDK default for the target framework -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework's casing and comparison rules (Windows NLS) instead of ICU. Without it, ToUpperInvariant and
         OrdinalIgnoreCase map more characters (e.g. Greek final sigma, Georgian), which changes the single-instance
         mutex name for such settings folders and could change file names; see RuntimeMigrationTests. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!-- The Windows runtime packs of ASP.NET Core carry its IIS in-process module, a native file that the single file
       would extract to disk. The app never runs in IIS (the local API is Kestrel only), so it is left out of the
       runtime pack's assets, which both ChanThreadWatch.deps.json and the publish are made from, as for ctw (see
       ChanThreadWatch.Cli.csproj). ResolveRuntimePackAssets also adds them to ReferenceCopyLocalPaths, so it goes
       from there too. -->
  <Target Name="RemoveIisModule" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <_CtwIisModule Include="@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
      <RuntimePackAsset Remove="@(_CtwIisModule)" />
      <ReferenceCopyLocalPaths Remove="@(_CtwIisModule)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ChanThreadWatch.Core\ChanThreadWatch.Core.csproj" />
    <!-- The local API that the app hosts (MP-7a). It brings the ASP.NET Core shared framework, which the
         self-contained single file then carries (no trimming) -->
    <ProjectReference Include="..\ChanThreadWatch.Api\ChanThreadWatch.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Classes\GUI.cs" />
    <Compile Include="Classes\LocalApiHost.cs" />
    <Compile Include="Classes\LocalApiSettings.cs" />
    <Compile Include="Classes\NewThreadChoices.cs" />
    <Compile Include="Classes\Shell.cs" />
    <Compile Include="frmChanThreadWatch.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmChanThreadWatch.Designer.cs">
      <DependentUpon>frmChanThreadWatch.cs</DependentUpon>
    </Compile>
    <Compile Include="frmLocalApi.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmLocalApi.Designer.cs">
      <DependentUpon>frmLocalApi.cs</DependentUpon>
    </Compile>
    <Compile Include="frmDownloads.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmDownloads.Designer.cs">
      <DependentUpon>frmDownloads.cs</DependentUpon>
    </Compile>
    <Compile Include="frmSettings.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmSettings.Designer.cs">
      <DependentUpon>frmSettings.cs</DependentUpon>
    </Compile>
    <Compile Include="frmThreadEdit.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmThreadEdit.Designer.cs">
      <DependentUpon>frmThreadEdit.cs</DependentUpon>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <EmbeddedResource Include="frmChanThreadWatch.resx">
      <SubType>Designer</SubType>
      <DependentUpon>frmChanThreadWatch.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="frmDownloads.resx">
      <DependentUpon>frmDownloads.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="frmLocalApi.resx">
      <DependentUpon>frmLocalApi.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="frmSettings.resx">
      <DependentUpon>frmSettings.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="frmThreadEdit.resx">
      <DependentUpon>frmThreadEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <None Include="app.manifest">
      <SubType>Designer</SubType>
    </None>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <Content Include="ChanThreadWatch.ico" />
  </ItemGroup>

</Project>
