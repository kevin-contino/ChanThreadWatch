{
  "openapi": "3.1.0",
  "info": {
    "title": "ChanThreadWatch local API",
    "version": "1",
    "description": "Off by default. Listens on 127.0.0.1 only. Every request needs the Host header 127.0.0.1:<port> or localhost:<port> and no query string. An Origin header must be this server's own (http://127.0.0.1:<port> or http://localhost:<port>) or a browser extension's (chrome-extension:// and 32 letters a-p, moz-extension:// and a lowercase UUID); without one, Sec-Fetch-Site must be absent, none or same-origin. Every route but POST /api/v1/pairing and POST /api/v1/proof needs Authorization: Bearer <token>, with the scripts' token (ctw_) or a paired browser's token (ctwe_). Those two take no token only in their one exact spelling (POST, that path, no other case, encoding, trailing slash or absolute-form target); any other spelling of them gets 401 with or without a token. The token is bound to the Origin: a paired browser's token passes only with the Origin it paired with, and the scripts' token never with an extension Origin (403 forbidden_origin). A request refused by these security checks (400, 401, 403, 429) also gets Connection: close, as does every refusal of the two pairing routes. Any other path gets 404 (NotFound) and any other method 405 (MethodNotAllowed, with Allow), after the checks. Every response has Cache-Control: no-store and X-Content-Type-Options: nosniff. Limits: 120 authenticated requests per minute, 30 adds per minute, 10 pairing requests and 60 proof requests per minute (each its own limit, apart from the authenticated one), 4 KiB bodies, 2048-character URLs, 1000 threads."
  },
  "servers": [
    { "url": "http://127.0.0.1:47710", "description": "The default port; the port is a setting (ApiPort)." }
  ],
  "security": [
    { "bearer": [] }
  ],
  "paths": {
    "/api/v1/threads": {
      "get": {
        "operationId": "listThreads",
        "summary": "List the watched threads",
        "responses": {
          "200": {
            "description": "The watched threads",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ThreadList" },
                "examples": {
                  "oneThread": {
                    "value": {
                      "threads": [
                        {
                          "id": "4chan/wg/100",
                          "url": "https://boards.4chan.org/wg/thread/100",
                          "description": "4chan_wg_100",
                          "category": "",
                          "state": "waiting",
                          "stopReason": null,
                          "addedOn": "2026-10-05T12:30:00+02:00",
                          "addedFrom": null
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      },
      "post": {
        "operationId": "addThread",
        "summary": "Add a thread to watch",
        "description": "Adds the thread with the program's defaults for a new thread. The body holds the URL only; a folder, login or any other member is refused. Unknown sites are refused unless the ApiAllowUnknownHosts setting is on, and even then IP addresses, local names and names that resolve to local or private addresses are refused.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddThreadRequest" },
              "examples": {
                "add": { "value": { "url": "https://boards.4chan.org/wg/thread/100" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The thread was added",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Thread" },
                "examples": {
                  "added": {
                    "value": {
                      "id": "4chan/wg/100",
                      "url": "https://boards.4chan.org/wg/thread/100",
                      "description": "4chan_wg_100",
                      "category": "",
                      "state": "running",
                      "stopReason": null,
                      "addedOn": "2026-10-05T12:30:00+02:00",
                      "addedFrom": null
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "The thread is already in the list (it is left as it is), is blacklisted, or the list is full",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Problem" },
                "examples": {
                  "alreadyWatched": {
                    "value": { "type": "about:blank", "title": "The thread is already in the list.", "status": 409, "code": "already_watched" }
                  }
                }
              }
            }
          },
          "408": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": {
            "description": "The URL is not accepted",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Problem" },
                "examples": {
                  "unknownHost": {
                    "value": { "type": "about:blank", "title": "The site is not a known site, and unknown sites are not allowed.", "status": 422, "code": "unknown_host" }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "507": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/pairing": {
      "post": {
        "operationId": "pairBrowser",
        "summary": "Pair a browser extension with a one-time code",
        "description": "No token. Needs the Origin of a browser extension (Chrome: the pinned extension id only). The program shows an 8-symbol code for 5 minutes; the code itself never goes over the wire. Step hello: the server answers its salt, a server nonce, its name and P1 = HMAC(K, \"ctw-pair-v1\", \"server-hello\", \"127.0.0.1:<port>\", origin, pairingId, clientNonce, serverNonce, serverName), where K = PBKDF2-HMAC-SHA256(code, salt, 600000, 32 bytes) and the lines are joined with a line feed. The extension checks P1 before it sends anything more. Step finish: the extension sends P2 = HMAC(K, \"ctw-pair-v1\", \"client-finish\", \"127.0.0.1:<port>\", origin, pairingId, clientNonce, serverNonce) with the nonces of an answered hello from the same Origin; the server answers the token and P3 = HMAC(K, \"ctw-pair-v1\", \"server-finish\", \"127.0.0.1:<port>\", origin, pairingId, clientNonce, serverNonce, token). Pairing replaces the browser family's older token (chrome or firefox); the scripts' token is never changed. A code answers 3 hellos; the 4th, a finish with a wrong proof or unknown nonces, and a finish after the code expired end the code (403 pairing_failed). Nonces and proofs are base64url without padding (43 characters), the pairingId and salt 22.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PairingRequest" },
              "examples": {
                "hello": { "value": { "step": "hello", "clientNonce": "ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hello: PairingHelloResponse. Finish: PairingFinishResponse; the token is shown only here.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PairingResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": {
            "description": "Not an extension Origin that may pair (forbidden_origin), or the code was ended by this request (pairing_failed)",
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "408": { "$ref": "#/components/responses/Problem" },
          "409": {
            "description": "No pairing code is active: none was made, it expired, was ended or used, or its file is not trusted (pairing_unavailable)",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Problem" },
                "examples": {
                  "pairingUnavailable": {
                    "value": { "type": "about:blank", "title": "No pairing code is active.", "status": 409, "code": "pairing_unavailable" }
                  }
                }
              }
            }
          },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/proof": {
      "post": {
        "operationId": "proveServer",
        "summary": "Prove this is the program that holds the token, before the token is sent",
        "description": "No token. With a paired extension's Origin, the key is the SHA-256 hash of that browser's token (only if the Origin is the one it paired with); without an Origin, the SHA-256 hash of the scripts' token. The proof is HMAC-SHA256(key, \"ctw-proof-v1\", \"127.0.0.1:<port>\", origin or an empty line, clientNonce), the lines joined with a line feed, base64url without padding. A client computes the same value from its token and sends the token only if they are equal: another program on the port cannot make it, and a proof for another port does not match.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProofRequest" },
              "examples": {
                "proof": { "value": { "clientNonce": "MDEyMzQ1Njc4OTo7PD0-P0BBQkNERUZHSElKS0xNTk8" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The proof",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProofResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": {
            "description": "Not an extension Origin that may ask (forbidden_origin), or nothing is paired for this Origin, or no scripts' token is set (not_paired)",
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "408": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "This document",
        "responses": {
          "200": {
            "description": "This document",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The scripts' token made in the program (ctw_ followed by 43 characters), or a paired browser's token (ctwe_ followed by 43 characters). Only their hashes are saved."
      }
    },
    "schemas": {
      "AddThreadRequest": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "maxLength": 2048, "description": "An absolute http or https thread URL without a login" }
        }
      },
      "Thread": {
        "type": "object",
        "required": ["id", "url", "description", "category", "state", "stopReason", "addedOn", "addedFrom"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string", "description": "Without a login" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "state": { "type": "string", "enum": ["running", "waiting", "stopped", "notFound"] },
          "stopReason": { "type": ["string", "null"], "enum": ["other", "userRequest", "exiting", "pageNotFound", "downloadComplete", "ioError", null] },
          "addedOn": { "type": "string", "format": "date-time" },
          "addedFrom": { "type": ["string", "null"], "description": "The id of the thread it was auto-followed from" }
        }
      },
      "ThreadList": {
        "type": "object",
        "required": ["threads"],
        "additionalProperties": false,
        "properties": {
          "threads": { "type": "array", "items": { "$ref": "#/components/schemas/Thread" } }
        }
      },
      "PairingRequest": {
        "type": "object",
        "required": ["step", "clientNonce"],
        "additionalProperties": false,
        "description": "hello: step and clientNonce only. finish: all five members.",
        "properties": {
          "step": { "type": "string", "enum": ["hello", "finish"] },
          "clientNonce": { "type": "string", "maxLength": 43, "description": "32 random bytes, base64url" },
          "pairingId": { "type": "string", "maxLength": 22, "description": "From the hello's answer" },
          "serverNonce": { "type": "string", "maxLength": 43, "description": "From the hello's answer" },
          "proof": { "type": "string", "maxLength": 43, "description": "P2" }
        }
      },
      "PairingResponse": {
        "type": "object",
        "description": "PairingHelloResponse (hello) or PairingFinishResponse (finish)",
        "additionalProperties": false,
        "properties": {
          "pairingId": { "type": "string" },
          "salt": { "type": "string" },
          "serverNonce": { "type": "string" },
          "serverName": { "type": "string", "maxLength": 80 },
          "proof": { "type": "string" },
          "token": { "type": "string" }
        }
      },
      "PairingHelloResponse": {
        "type": "object",
        "required": ["pairingId", "salt", "serverNonce", "serverName", "proof"],
        "additionalProperties": false,
        "properties": {
          "pairingId": { "type": "string", "maxLength": 22 },
          "salt": { "type": "string", "maxLength": 22 },
          "serverNonce": { "type": "string", "maxLength": 43 },
          "serverName": { "type": "string", "maxLength": 80, "description": "Printable, without line breaks; shown before the token is saved" },
          "proof": { "type": "string", "maxLength": 43, "description": "P1" }
        }
      },
      "PairingFinishResponse": {
        "type": "object",
        "required": ["token", "proof"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "maxLength": 48, "description": "ctwe_ followed by 43 characters; save it only after P3 checks" },
          "proof": { "type": "string", "maxLength": 43, "description": "P3" }
        }
      },
      "ProofRequest": {
        "type": "object",
        "required": ["clientNonce"],
        "additionalProperties": false,
        "properties": {
          "clientNonce": { "type": "string", "maxLength": 43, "description": "32 random bytes, base64url" }
        }
      },
      "ProofResponse": {
        "type": "object",
        "required": ["proof"],
        "additionalProperties": false,
        "properties": {
          "proof": { "type": "string", "maxLength": 43 }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "code": {
            "type": "string",
            "enum": [
              "invalid_host", "query_not_allowed", "forbidden_origin", "unauthorized", "not_found", "method_not_allowed",
              "unsupported_media_type", "body_too_large", "request_timeout", "invalid_body", "invalid_url", "unknown_host", "blocked_host",
              "unresolvable_host", "rate_limited", "add_rate_limited", "already_watched", "blacklisted", "thread_limit",
              "insufficient_storage", "unavailable", "marks_unavailable", "pairing_unavailable", "pairing_failed", "not_paired",
              "pairing_rate_limited", "internal_error"
            ]
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "No such path (sent after the request checks)",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "MethodNotAllowed": {
        "description": "The path exists but not with this method (sent after the request checks)",
        "headers": {
          "Allow": { "schema": { "type": "string" } }
        },
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "InternalError": {
        "description": "The request failed in the program",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "Problem": {
        "description": "An error",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "BadRequest": {
        "description": "Wrong Host header, a query string, or a body that is not the JSON object of the operation",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "Unauthorized": {
        "description": "No valid bearer token",
        "headers": {
          "WWW-Authenticate": { "schema": { "type": "string", "const": "Bearer" } }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" },
            "examples": {
              "unauthorized": {
                "value": { "type": "about:blank", "title": "A valid bearer token is required.", "status": 401, "code": "unauthorized" }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "A request from a browser page of another origin, or a token used with an Origin it is not bound to",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "TooManyRequests": {
        "description": "Over a rate limit",
        "headers": {
          "Retry-After": { "schema": { "type": "integer" } }
        },
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "Unavailable": {
        "description": "The program is busy or exiting, or (POST, marks_unavailable) the list of threads added through the API can't be saved this session",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      }
    }
  }
}
