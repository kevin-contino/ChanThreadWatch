<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>JDP.Cli.Tests</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same globalization mode as the app and ctw (see ChanThreadWatch.csproj) -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\ChanThreadWatch.Cli\ChanThreadWatch.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The version source of every app (G13); a test checks that ctw reports the same version -->
    <None Include="..\src\ChanThreadWatch\Properties\AssemblyInfo.cs" Link="WinFormsAssemblyInfo.cs.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- ctw watch runs against the loopback test server and the sterile 4chan thread of the Core integration tests -->
    <Compile Include="..\ChanThreadWatch.Core.Tests\Integration\LoopbackHttpServer.cs" Link="Integration\LoopbackHttpServer.cs" />
    <Compile Include="..\ChanThreadWatch.Core.Tests\Integration\FourChanThreadFixture.cs" Link="Integration\FourChanThreadFixture.cs" />
    <!-- Every test assembly sends the default folders and the application data folder to a temporary folder -->
    <Compile Include="..\ChanThreadWatch.Core.Tests\TestDefaultFolders.cs" Link="TestDefaultFolders.cs" />
    <Compile Include="..\ChanThreadWatch.Api.Tests\TestTokenCheck.cs" Link="TestTokenCheck.cs" />
    <None Include="..\ChanThreadWatch.Tests\Fixtures\4chan-thread-loopback.html" Link="Fixtures\4chan-thread-loopback.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
